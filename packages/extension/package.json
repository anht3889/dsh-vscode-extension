{
  "name": "dsh",
  "displayName": "DeepSeek Harness",
  "description": "DeepSeek Harness control plane for VS Code — an AI coding agent chat sidecar.",
  "version": "0.1.0",
  "publisher": "anhtra3889",
  "license": "MIT",
  "icon": "resources/dsh.png",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/dsh-vscode-extension.git"
  },
  "homepage": "https://github.com/your-org/dsh-vscode-extension#readme",
  "readme": "README.md",
  "activationEvents": [
    "onView:dsh.chat",
    "onCommand:dsh.start"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dsh.start",
        "title": "Start",
        "category": "DeepSeek Harness"
      },
      {
        "command": "dsh.stop",
        "title": "Stop",
        "category": "DeepSeek Harness"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "DeepSeek Harness",
          "icon": "resources/dsh.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dsh.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "dsh.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the dsh binary. When empty, DeepSeek Harness probes nvm and common Homebrew locations before falling back to the extension host PATH."
        },
        "dsh.handshakeTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "How long to wait for dsh to report itself ready before giving up. Raise this if chat reports 'no handshake' on a slow or heavily loaded machine."
        }
      }
    }
  },
  "dependencies": {
    "@dsh-vscode/contract": "workspace:0.1.0",
    "markdown-it": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3",
    "esbuild": "^0.21.0",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "vitest": "^3"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "node e2e-build.mjs && node dist-test/e2e.run.js"
  }
}
