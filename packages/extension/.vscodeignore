# Files excluded from the packaged .vsix.
# `vsce package` ships everything not ignored here; keep `dist/**` (the built
# runtime bundle that MUST ship), `resources/dsh.svg` (the activity-bar icon)
# and `resources/dsh.png` (the marketplace icon).

# full-colour master artwork; only used to regenerate the two shipped icons
resources/dsh-logo.svg

# source (TypeScript + tests) — not needed at runtime
src/**
test/**
*.test.*
*.spec.*

# E2E build artifacts + tooling
dist-test/**
e2e-build.mjs
coverage/**
**/.vite/**

# build/tooling config
vitest.config.ts
tsconfig.json
tsconfig.e2e.json
esbuild.mjs

# source maps contain embedded source and are not required at runtime
dist/**/*.map

# bundled dependencies are already present in dist/extension.js and dist/webview.js
node_modules/**

# repository-only material and accidental local output
.superpowers/**
docs/**
**/.DS_Store
**/*.log
**/*.vsix

# local configuration and credential material must never enter a package
**/.env
**/.env.*
**/settings.yaml
**/settings.yml
**/settings.json
**/.credentials.yaml
**/.credentials.yml
**/.credentials.json
**/credentials.yaml
**/credentials.yml
**/credentials.json
